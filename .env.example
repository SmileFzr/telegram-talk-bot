# ---- 必填 ----------------------------------------------------------
# 在 Telegram 找 @BotFather -> 发送 /newbot -> 按提示创建 -> 复制 token
# 形如 123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 注意：本文件是要提交到 Git 的模板，永远不要把真实 token 写在这里！真实 token 只放 .env
TOKEN=

# 你自己的 Chat ID（别人的消息会被转到这里）
# 获取方法：先只填 TOKEN 启动机器人，对它发 /id，把返回的数字填到这里再重启
# 私聊是正数，如 123456789；群聊是负数，如 -1001234567890
ADMIN_CHAT_ID=

# ---- 可选 ----------------------------------------------------------
# 转发索引文件（记录哪条消息对应哪个用户，重启后仍能回复）
STATE_FILE=forward_map.json

# 是否给发消息的人自动回一条「已收到，已转交给管理员」，true / false
SEND_ACK=false

# 最多保留多少条转发索引，超出后淘汰最旧的
MAX_TRACKED=5000

# 国内访问 api.telegram.org 必须走代理。填你当前可用的本地代理地址，
# 例如 http://127.0.0.1:20122（请按自己代理软件的实际端口修改）。
# 留空则使用系统代理环境变量。注意系统里残留的失效代理会导致 TimedOut。
PROXY_URL=

# 只接受私聊消息，忽略群聊消息（建议 true，避免机器人被拉进群后刷屏）
# 注意：Telegram 机器人默认开启隐私模式，群里只能收到 /命令 和 @提及 的消息；
#       若确实想收群内所有消息，需在 @BotFather 里 /setprivacy 选 Disable。
PRIVATE_ONLY=false

# 管理员发了「非回复」消息时给一次用法提示（60 秒内最多一次）
ADMIN_HINT=true

# 回传时让对方看到「引用自己原消息」的引用条，true / false
REPLY_QUOTE=true
